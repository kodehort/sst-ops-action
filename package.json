{
  "name": "sst-operations-action",
  "version": "0.7.62",
  "description": "A unified GitHub Action for SST operations: deploy, diff, and remove",
  "keywords": [
    "github-actions",
    "sst",
    "serverless",
    "infrastructure-as-code",
    "deploy",
    "diff",
    "remove"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodehort/sst-ops-action.git"
  },
  "license": "MIT",
  "author": "Your Organization",
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check": "ultracite check",
    "dev": "bunx @github/local-action run . src/main.ts .env",
    "fallow:audit": "fallow audit --quiet",
    "fix": "ultracite fix",
    "format": "bun run fix",
    "format:check": "bun run check",
    "lint": "bun run check",
    "snapshots:generate": "bun run scripts/generate-snapshots.ts",
    "snapshots:generate:force": "bun run scripts/generate-snapshots.ts --force",
    "snapshots:validate": "bun run scripts/generate-snapshots.ts --validate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:snapshots": "vitest run __tests__/snapshots/",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/bun": "^1.3.9",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "fallow": "3.17.0",
    "typescript": "^7.0.0",
    "ultracite": "7.10.5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}

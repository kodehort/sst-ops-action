{
  "name": "sst-operations-action",
  "version": "0.7.27",
  "description": "A unified GitHub Action for SST operations: deploy, diff, and remove",
  "keywords": [
    "github-actions",
    "sst",
    "serverless",
    "infrastructure-as-code",
    "deploy",
    "diff",
    "remove"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodehort/sst-ops-action.git"
  },
  "license": "MIT",
  "author": "Your Organization",
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rollup --config rollup.config.ts --configPlugin 'typescript={\"sourceMap\":false}'",
    "dev": "bunx @github/local-action run . src/main.ts .env",
    "format": "bunx ultracite@latest fix",
    "format:check": "bunx ultracite@latest format --check",
    "lint": "bunx ultracite@latest check",
    "snapshots:generate": "bun run scripts/generate-snapshots.ts",
    "snapshots:generate:force": "bun run scripts/generate-snapshots.ts --force",
    "snapshots:validate": "bun run scripts/generate-snapshots.ts --validate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:snapshots": "vitest run __tests__/snapshots/",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@actions/artifact": "^6.1.0",
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.0.0",
    "@actions/io": "^3.0.2",
    "picomatch": "^4.0.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "^1.3.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "@types/yaml": "^1.9.7",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.28.0",
    "js-yaml": "^5.0.0",
    "rollup": "^4.57.1",
    "typescript": "^5.9.3",
    "ultracite": "7.10.0",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
